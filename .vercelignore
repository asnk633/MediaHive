# Ignore experimental / disabled backend
src/app/_api_disabled/
src/server_disabled/

# Ignore cron
src/app/api/cron/

# Ignore test & debug material
__tests__/
__tests_archive__/
e2e/
src/tests/
build-output.txt
build_log_debug.txt
dev_log_debug.txt
test_output_debug.txt
test_output_debug_2.txt

# Ignore scripts & diagnostics
scripts/
functions/
debug_*.js
inspect_*.py
*.log

# Ignore compiled builds and binaries recursively
**/*.apk
**/*.exe
**/*.dmg
**/*.zip
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.pdb
**/*.lib
**/*.rlib
**/*.glb
**/*.gltf

# Ignore Next.js build cache
.next
.next/
.next/**
**/.next/**

# Ignore public assets that are too large
public/*.apk
public/**/*.apk
public/video/
public/*.glb
public/**/*.glb

# Ignore heavy directories that exceed Vercel CLI upload size limit
mediahive_mobile/
MediaHive Windows app/
website/
graphify-out/
.agent/
.agents/
.tmp/
docs/
reports/
execution/
scratch/
serviceAccountKey.json
