{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaHive",
  "version": "0.1.2",
  "identifier": "com.mediahive.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaHive",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "licenseFile": "license.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "certificateThumbprint": "A67461351583356547710B064D8577B58112C5AD",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/asnk633/MediaHive/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MDU4MTk0RkE2QjFFNzEKUldSeEhtdjZsSUVGZU1sVWswbzBNOWRPd3FteUZ6SjJrZTZ4d1RvaHFUeW5mWHBKbldjZ1ZWUysK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mediahive"]
      }
    }
  }
}
