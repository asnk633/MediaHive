{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaHive",
  "version": "0.1.3",
  "identifier": "com.mediahive.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaHive",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lh3.googleusercontent.com https://lh4.googleusercontent.com https://drive.google.com https://drive.usercontent.google.com https://*.supabase.co; connect-src 'self' ipc: https://*.supabase.co wss://*.supabase.co; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "licenseFile": "license.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/asnk633/MediaHive/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MDU4MTk0RkE2QjFFNzEKUldSeEhtdjZsSUVGZU1sVWswbzBNOWRPd3FteUZ6SjJrZTZ4d1RvaHFUeW5mWHBKbldjZ1ZWUysK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["mediahive"]
      }
    }
  }
}
